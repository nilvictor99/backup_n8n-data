      "parameters": {
        "jsCode": "// Construye un índice legible id -> nombre actual, usando TODOS los workflows traídos\nconst items = $('Captura de Workflows1').all();\n\nconst index = items.map(item => ({\n  id: item.json.id,\n  name: item.json.name,\n  updatedAt: item.json.updatedAt || null\n}));\n\nreturn [{\n  json: {\n    filePath: 'index.json',\n    fileContent: JSON.stringify(index, null, 2)\n  }\n}];"
      },
