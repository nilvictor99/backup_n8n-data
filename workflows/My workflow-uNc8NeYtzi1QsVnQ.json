{"updatedAt":"2026-08-08T21:52:46.514Z","createdAt":"2026-08-08T20:51:54.474Z","id":"uNc8NeYtzi1QsVnQ","name":"Scan-Drive → YouTube Multi-Género","active":false,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":30}]}},"id":"1095b1f2-b952-4c6b-b045-abe9bf757371","name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.3,"position":[-1136,512],"webhookId":"schedule-trigger-main"},{"parameters":{"jsCode":"// Géneros Activos - Define los géneros a procesar\nreturn [\n  { \n    genero: \"rock\", \n    folderId: \"PLACEHOLDER_FOLDER_ID_ROCK\", \n    sheetId: \"PLACEHOLDER_SHEET_ID_LIST_ROCK\", \n    credentialKey: \"yt_rock\" \n  },\n  { \n    genero: \"funk\", \n    folderId: \"PLACEHOLDER_FOLDER_ID_FUNK\", \n    sheetId: \"PLACEHOLDER_SHEET_ID_LIST_FUNK\", \n    credentialKey: \"yt_funk\" \n  }\n];"},"id":"2786f898-1a82-42d2-99d6-58da6eb0824a","name":"Géneros Activos","type":"n8n-nodes-base.code","typeVersion":2,"position":[-944,512]},{"parameters":{"options":{}},"id":"b90ed9f0-05a3-44aa-83d7-fe0b0f457371","name":"Loop Géneros","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[-736,512]},{"parameters":{"operation":"search"},"id":"93ec423a-91ea-479c-9274-ba1e84c5f20e","name":"Busca Archivos","type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[-544,512],"alwaysOutputData":true},{"parameters":{"jsCode":"// Procesa los Datos - Normaliza la información de archivos de Drive\nconst items = $input.all()[0]?.json?.files || $input.all() || [];\nconst genero = $('Loop Géneros').item.json.genero;\nconst sheetId = $('Loop Géneros').item.json.sheetId;\n\nconst results = [];\nfor (const item of items) {\n  if (!item.id) continue;\n  const name = item.name || '';\n  const extMatch = name.match(/\\.[^/.]+$/);\n  const extension = extMatch ? extMatch[0].toLowerCase() : '';\n  const nombreSinExt = name.replace(/\\.[^/.]+$/, '');\n  const sizeBytes = parseInt(item.size || 0);\n  const sizeMB = (sizeBytes / (1024 * 1024)).toFixed(2);\n\n  results.push({\n    id: item.id,\n    Nombre: nombreSinExt,\n    Tipo: item.mimeType || 'video/mp4',\n    Extension: extension,\n    Tamaño_bytes: sizeBytes,\n    Tamaño_MB: sizeMB,\n    Creado: item.createdTime || $now.toISOString(),\n    Modificado: item.modifiedTime || $now.toISOString(),\n    Ultima_Actualizacion: $now.toISOString(),\n    upload: false,\n    youtube_video_id: '',\n    error: '',\n    genero: genero,\n    sheetId: sheetId,\n    fullName: name\n  });\n}\n\nreturn results;"},"id":"f177fcae-4a2c-4a06-a183-686c343bee0b","name":"Procesa los Datos","type":"n8n-nodes-base.code","typeVersion":2,"position":[-336,512]},{"parameters":{"operation":"appendOrUpdate","documentId":{"__rl":true,"value":"={{ $json.sheetId }}","mode":"id"},"sheetName":{"__rl":true,"value":"={{ $('Loop Géneros').item.json.genero }}","mode":"name"},"columns":{"mappingMode":"autoMapInputData","value":null,"matchingColumns":["id"],"schema":[{"id":"id","displayName":"id","required":false,"defaultMatch":false},{"id":"Nombre","displayName":"Nombre","required":false,"defaultMatch":false},{"id":"Tipo","displayName":"Tipo","required":false,"defaultMatch":false},{"id":"Extension","displayName":"Extension","required":false,"defaultMatch":false},{"id":"Tamaño_bytes","displayName":"Tamaño_bytes","required":false,"defaultMatch":false},{"id":"Tamaño_MB","displayName":"Tamaño_MB","required":false,"defaultMatch":false},{"id":"Creado","displayName":"Creado","required":false,"defaultMatch":false},{"id":"Modificado","displayName":"Modificado","required":false,"defaultMatch":false},{"id":"Ultima_Actualizacion","displayName":"Ultima_Actualizacion","required":false,"defaultMatch":false},{"id":"upload","displayName":"upload","required":false,"defaultMatch":false},{"id":"youtube_video_id","displayName":"youtube_video_id","required":false,"defaultMatch":false},{"id":"error","displayName":"error","required":false,"defaultMatch":false}]},"options":{}},"id":"971776c8-12d6-4915-a95a-d277c84ededa","name":"Actualiza Estado Sheet","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[-144,512]},{"parameters":{"documentId":{"__rl":true,"value":"={{ $('Loop Géneros').item.json.sheetId }}","mode":"id"},"sheetName":{"__rl":true,"value":"={{ $('Loop Géneros').item.json.genero }}","mode":"name"},"options":{}},"id":"34bd7868-fe6d-491d-a60b-e4a539b3f5fc","name":"Lee Estado Sheet","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[64,512],"alwaysOutputData":true},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"cond-1","leftValue":"={{ $json.upload }}","rightValue":"true","operator":{"type":"string","operation":"notEquals"}},{"id":"cond-2","leftValue":"={{ $json.upload }}","rightValue":true,"operator":{"type":"boolean","operation":"notEquals"}}],"combinator":"and"},"options":{}},"id":"4476d04f-aebc-4b92-a2d9-447bba910a5a","name":"¿Hay Pendientes?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[272,512]},{"parameters":{"options":{}},"id":"0eda282b-f452-4eea-ae08-9a77ef202a7a","name":"Loop Videos","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[464,512]},{"parameters":{"jsCode":"// Define detalles de video según género\nconst item = $input.first().json;\nconst genero = item.genero || $('Loop Géneros').item.json.genero;\n\nconst hashtagsRock = ['#RockPeruano', '#RockLatino', '#RockIndie', '#RockClasico', '#RockEnEspanol', '#RockAndRoll', '#RockAlternativo', '#RockNacional'];\nconst hashtagsFunk = ['#FunkPeruano', '#FunkLatino', '#FunkSoul', '#Groove', '#FunkMusic', '#FunkBrasilero', '#FunkClassics', '#NeoFunk'];\n\nconst emojisRock = ['🎸', '🤘', '🔥', '⚡', '🎵', '🎶', '🥁', '🎙️'];\nconst emojisFunk = ['🕺', '💃', '🎷', '🎺', '🔥', '✨', '🎵', '🎶'];\n\nlet hashtags, emojis, description, tags;\n\nif (genero === 'rock') {\n  hashtags = hashtagsRock[Math.floor(Math.random() * hashtagsRock.length)];\n  emojis = emojisRock[Math.floor(Math.random() * emojisRock.length)];\n  description = `🎸 ${item.Nombre} - Rock en español e independiente.\\n\\nDisfruta de lo mejor del rock peruano y latinoamericano.\\n\\n#Rock #Musica #RockEnEspanol ${hashtags}`;\n  tags = ['rock', 'rock en español', 'rock peruano', 'rock latino', 'música', 'indie rock'];\n} else {\n  hashtags = hashtagsFunk[Math.floor(Math.random() * hashtagsFunk.length)];\n  emojis = emojisFunk[Math.floor(Math.random() * emojisFunk.length)];\n  description = `🕺 ${item.Nombre} - Funk y Groove latino.\\n\\nEl mejor funk peruano y latinoamericano para mover el cuerpo.\\n\\n#Funk #Musica #Groove ${hashtags}`;\n  tags = ['funk', 'funk latino', 'funk peruano', 'groove', 'música', 'soul'];\n}\n\nreturn [{\n  ...item,\n  hashtags: hashtags,\n  emojis: emojis,\n  description: description,\n  tags: tags,\n  title: `${item.Nombre} ${hashtags} ${emojis}`,\n  genero: genero\n}];"},"id":"ec7f8e84-b76b-41a8-b4b6-245ee9d81d5f","name":"Define detalles de video","type":"n8n-nodes-base.code","typeVersion":2,"position":[672,512]},{"parameters":{"operation":"download","fileId":{"__rl":true,"value":"={{ $json.id }}","mode":"id"},"options":{}},"id":"36dd24f3-ee32-450f-8869-1a4706f61d55","name":"Descarga Video","type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[864,512]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"cond-rock","leftValue":"={{ $json.genero }}","rightValue":"rock","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"id":"b657fbee-44b1-41c1-94fb-933305e4d2ab","name":"¿Qué género?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1072,512]},{"parameters":{"filters":{},"options":{}},"id":"4a6afc93-3efb-41a4-9b02-0d3568b51371","name":"Upload Rock","type":"n8n-nodes-base.youTube","typeVersion":1,"position":[1264,400]},{"parameters":{"filters":{},"options":{}},"id":"f833e332-b34a-428b-afe4-59