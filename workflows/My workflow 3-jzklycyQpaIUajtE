          "jsCode": "// ===== ANALIZAR ACCIONES (Yahoo Finance v8 chart, 3 meses diarios) =====\nconst filas = $input.all().map(i => i.json);\nconst sma = (a, n) => a.length >= n ? a.slice(-n).reduce((x, y) => x + y, 0) / n : null;\nconst rsi14 = c => {\n  const n = 14; if (c.length < n + 1) return null;\n  let g = 0, l = 0;\n  for (let i = c.length - n; i < c.length; i++) { const d = c[i] - c[i - 1]; if (d >= 0) g += d; else l -= d; }\n  if (l === 0) return 100;\n  return 100 - 100 / (1 + g / l);\n};\nconst ret = (c, d) => c.length > d ? (c[c.length - 1] / c[c.length - 1 - d] - 1) * 100 : null;\n\nconst lista = []; let fallidos = 0;\nfor (const j of filas) {\n  const r = j && j.chart && j.chart.result && j.chart.result[0];\n  const c = r && r.indicators && r.indicators.quote && r.indicators.quote[0] && r.indicators.quote[0].close;\n  const cierres = Array.isArray(c) ? c.filter(Number.isFinite) : [];\n  if (!r || cierres.length < 22) { fallidos++; continue; }\n\n  const p = cierres[cierres.length - 1];\n  const s20 = sma(cierres, 20), s50 = sma(cierres, 50), rsi = rsi14(cierres);\n  const r1 = ret(cierres, 1), r5 = ret(cierres, 5), r21 = ret(cierres, 21);\n\n  let score = 0;\n  if (s20 && s50) {\n    if (p > s20 && s20 > s50) score += 2;       // tendencia alcista fuerte\n    else if (p > s50) score += 1;               // alcista moderada\n    else if (p < s20 && s20 < s50) score -= 2;  // tendencia bajista\n    else score -= 1;\n  } else if (s20) { score += p > s20 ? 1 : -1; }\n  if (rsi != null) {\n    if (rsi >= 45 && rsi <= 65) score += 1;     // momentum sano\n    else if (rsi > 75) score -= 2;              // sobrecompra\n    else if (rsi < 30) score += 0.5;            // sobreventa (posible rebote)\n  }\n  score += r5 > 0 ? 1 : -1;\n  score += r21 > 0 ? 1 : -1;\n\n  lista.push({\n    ticker: r.meta.symbol, precio: p, moneda: r.meta.currency || 'USD',\n    r1, r5, r21, rsi, sma20: s20, sma50: s50, score,\n    senal: score >= 3 ? '🟢' : score >= 0 ? '🟡' : '🔴'\n  });\n}\nlista.sort((a, b) => b.score - a.score || (b.r21 || 0) - (a.r21 || 0));\nreturn [{ json: { tipo: 'acciones', total: filas.length, fallidos, top: lista.slice(0, 5), bottom: lista.slice(-3).reverse() } }];\n"
