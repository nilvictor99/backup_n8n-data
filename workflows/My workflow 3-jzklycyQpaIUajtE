      "parameters": {
        "jsCode": "// ===== ANALIZAR CRIPTOS (CoinGecko /coins/markets) =====\nconst filas = $input.all().map(i => i.json);\nconst stable = new Set(['usdt','usdc','dai','fdusd','tusd','usde','usds','pyusd','usdd','usdg','busd','susd','frax','lusd','eurc','usd1','rlusd','usdt0']);\nconst n = v => Number.isFinite(Number(v)) && v !== null ? Number(v) : null;\n\nconst lista = []; let fallidos = 0;\nfor (const j of filas) {\n  if (!j || !j.symbol || n(j.current_price) === null) { fallidos++; continue; }\n  if (stable.has(String(j.symbol).toLowerCase())) continue;\n  const p24 = n(j.price_change_percentage_24h_in_currency ?? j.price_change_percentage_24h);\n  const p7 = n(j.price_change_percentage_7d_in_currency);\n  const p30 = n(j.price_change_percentage_30d_in_currency);\n  const volRatio = n(j.market_cap) ? n(j.total_volume) / n(j.market_cap) : null;\n\n  let score = 0;\n  if (p7 !== null) score += p7 > 0 ? 1 : -1;\n  if (p30 !== null) score += p30 > 0 ? 1 : -1;\n  if (p24 !== null) score += p24 > 0 ? 1 : -1;\n  if (p24 !== null && p24 > 20) score -= 2;           // posible sobrecalentamiento\n  if (volRatio !== null && volRatio > 0.05) score += 1; // buena liquidez / interés\n  if (p30 !== null && p30 < -30) score -= 1;          // caída fuerte sostenida\n\n  lista.push({\n    symbol: String(j.symbol).toUpperCase(), nombre: j.name, rank: j.market_cap_rank,\n    precio: n(j.current_price), p24, p7, p30, volRatio, score,\n    senal: score >= 3 ? '🟢' : score >= 1 ? '🟡' : '🔴'\n  });\n}\nlista.sort((a, b) => b.score - a.score || (b.p7 || 0) - (a.p7 || 0));\nreturn [{ json: { tipo: 'cripto', fallidos, total: filas.length, top: lista.slice(0, 5), bottom: lista.slice(-3).reverse() } }];\n"
      },
