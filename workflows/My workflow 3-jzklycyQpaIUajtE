    {
      "parameters": {
        "jsCode": "// ===== FORMATEAR MENSAJE =====\nconst filas = $input.all().map(i => i.json);\nconst ac = filas.find(x => x.tipo === 'acciones') || { top: [], bottom: [], total: 0, fallidos: 0 };\nconst cr = filas.find(x => x.tipo === 'cripto') || { top: [], bottom: [], total: 0, fallidos: 0 };\n\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst pct = v => v === null || v === undefined ? 's/d' : (v >= 0 ? '+' : '') + v.toFixed(2) + '%';\nconst px = v => v >= 1 ? v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : v.toPrecision(3);\nconst hora = Number(new Date().toLocaleString('en-US', { timeZone: 'America/Lima', hour: 'numeric', hourCycle: 'h23' }));\nconst saludo = hora < 12 ? '☀️ ¡Buenos días!' : hora < 19 ? '🌤️ ¡Buenas tardes!' : '🌙 ¡Buenas noches!';\nlet fecha = new Date().toLocaleDateString('es-PE', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Lima' });\nfecha = fecha.charAt(0).toUpperCase() + fecha.slice(1);\n\nconst lAc = a => `${a.senal} <b>${esc(a.ticker)}</b> $${px(a.precio)} · 1d ${pct(a.r1)} · 5d ${pct(a.r5)} · 1m ${pct(a.r21)} · RSI ${a.rsi === null ? 's/d' : a.rsi.toFixed(0)} · pts ${a.score}`;\nconst lCr = c => `${c.senal} <b>${esc(c.symbol)}</b> $${px(c.precio)} · 24h ${pct(c.p24)} · 7d ${pct(c.p7)} · 30d ${pct(c.p30)} · pts ${c.score}`;\n\nconst sinAc = !ac.top.length, sinCr = !cr.top.length;\nconst metodo = 'Puntaje = tendencia (precio vs medias de 20 y 50 días), RSI de 14 días, y retorno de 5 días y 1 mes (acciones); cambio 24h/7d/30d y volumen (criptos). Es un ranking de momentum, no una predicción.';\nconst disclaimer = 'Información con fines educativos, no es asesoría financiera. Los precios son de fuentes gratuitas y pueden tener retraso. Investiga y decide por tu cuenta antes de invertir.';\n\nconst tg = [\n  `${saludo} Tu radar diario de inversión 📊`,\n  `📅 <i>${fecha}</i>`,\n  '━━━━━━━━━━━━━━━',\n  '',\n  '📈 <b>ACCIONES / ETFs con mejor puntaje</b>',\n  ...(sinAc ? ['⚠️ No se pudieron obtener datos de acciones hoy.'] : ac.top.map(lAc)),\n  '',\n  ...(sinAc ? [] : ['⚠️ <b>Más débiles</b>', ...ac.bottom.map(lAc), '']),\n  '🪙 <b>CRIPTOS con mejor puntaje</b>',\n  ...(sinCr ? ['⚠️ No se pudieron obtener datos de criptos hoy.'] : cr.top.map(lCr)),\n  '',\n  ...(sinCr ? [] : ['⚠️ <b>Más débiles</b>', ...cr.bottom.map(lCr), '']),\n  '━━━━━━━━━━━━━━━',\n  `ℹ️ <b>¿Cómo se calcula?</b>\\n${metodo}`,\n  '',\n  `⚠️ <i>${disclaimer}</i>`,\n  '',\n  '🌐 Fuentes: Yahoo Finance (acciones) · CoinGecko (criptos)'\n].join('\\n').replace(/\\n{3,}/g, '\\n\\n').slice(0, 4000);\n\nconst fila = (html, color) => `<div style=\"background:#fff;border-radius:10px;padding:10px 14px;margin:6px 0;border-left:5px solid ${color};font-size:14px;line-height:1.5\">${html}</div>`;\nconst col = s => s === '🟢' ? '#2e7d32' : s === '🟡' ? '#f9a825' : '#c62828';\nconst bloque = (titulo, arr, f) => `<h3 style=\"margin:18px 0 6px 0\">${titulo}</h3>${arr.length ? arr.map(f).join('') : '<div style=\"font-size:13px;color:#777\">Sin datos hoy.</div>'}`;\n\nconst mail = `\n<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:600px;margin:auto;background:#f4f6f8;padding:20px;border-radius:16px;color:#222\">\n<h2 style=\"margin:0 0 4px 0\">${saludo} Radar diario de inversión</h2>\n<div style=\"color:#666;font-size:14px\">📅 ${fecha}</div>\n${bloque('📈 Acciones / ETFs con mejor puntaje', ac.top, a => fila(lAc(a), col(a.senal)))}\n${ac.bottom.length ? bloque('⚠️ Acciones más débiles', ac.bottom, a => fila(lAc(a), col(a.senal))) : ''}\n${bloque('🪙 Criptos con mejor puntaje', cr.top, c => fila(lCr(c), col(c.senal)))}\n${cr.bottom.length ? bloque('⚠️ Criptos más débiles', cr.bottom, c => fila(lCr(c), col(c.senal))) : ''}\n<div style=\"background:#fff;border-radius:12px;padding:12px 16px;margin:16px 0;font-size:13px;line-height:1.5\"><b>ℹ️ ¿Cómo se calcula?</b><br>${metodo}</div>\n<div style=\"background:#fff3e0;border-radius:12px;padding:12px 16px;margin:12px 0;font-size:13px;line-height:1.5\">⚠️ <i>${disclaimer}</i></div>\n<div style=\"font-size:12px;color:#888\">🌐 Fuentes: Yahoo Finance · CoinGecko</div>\n</div>`;\n\nconst l1 = ac.top[0] ? ac.top[0].ticker : null, l2 = cr.top[0] ? cr.top[0].symbol : null;\nconst asunto = `📊 Radar diario${l1 ? ' · 📈 ' + l1 : ''}${l2 ? ' · 🪙 ' + l2 : ''}`;\nreturn [{ json: { asunto, mensaje_telegram: tg, mensaje_email: mail } }];\n"
      },
