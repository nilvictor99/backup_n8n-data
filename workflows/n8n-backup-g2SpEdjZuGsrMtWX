    {
      "parameters": {
        "jsCode": "let output = [];\n\nlet n8nItems = $('Preparar Nombre de Archivo (usa ID, no nombre)').all();\nlet githubNames = $('limpiar datos github').first().json.name || [];\n\n// === MAPA DE WORKFLOWS DE N8N ===\nlet n8nMap = new Map();\n\n// Formato actual: workflows/n8n-backup-g2SpEdjZuGsrMtWX\nfor (let item of n8nItems) {\n  let full = item.json.name || '';\n  let workflowId = item.json.id || '';\n\n  let name = full.replace(/^workflows\\/[^\\/]+\\//, '');\n  name = name.replace(/^n8n-backup-/, '');\n\n  n8nMap.set(workflowId, {\n    source: 'n8n',\n    full: full,\n    name: name,\n    id: workflowId\n  });\n}\n\n// === MAPA DE ARCHIVOS EN GITHUB ===\nlet githubMap = new Map();\n\nfor (let filename of githubNames) {\n  let withoutExt = filename.replace(/\\.json$/, '');\n  let parts = withoutExt.split('_');\n  if (parts.length > 0) {\n    let fullName = withoutExt;\n    let name = fullName.replace(/^n8n-backup-/, '');\n\n    githubMap.set(fullName, {\n      source: 'github',\n      full: filename,\n      name: name,\n      id: fullName\n    });\n  }\n}\n\n// === DETECTAR CAMBIOS DE NOMBRE ===\nfor (let [workflowId, n8n] of n8nMap) {\n  let gh = githubMap.get(n8n.full);   // buscamos por nombre completo del archivo\n\n  if (gh && n8n.name !== gh.name) {\n    output.push({ json: { n8n, github: gh } });\n  }\n}\n\nreturn output;"
      },
