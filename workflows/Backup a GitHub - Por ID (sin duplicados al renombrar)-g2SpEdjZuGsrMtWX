    {
      "parameters": {
        "jsCode": "// Compara los workflows actuales de n8n contra los archivos que ya existen en GitHub,\n// usando el ID real de cada workflow para encontrar coincidencias.\n// La comparación ignora si el archivo tiene o no extensión .json, para no marcar\n// como \"rename\" algo que solo difiere en la extensión.\n\nconst workflows = items; // viene de \"Captura de Workflows2\"\nconst githubFiles = $('Get Índice1').all();\n\nfunction stripExt(name) {\n  return name.replace(/\\.json$/i, '');\n}\n\nfunction extractId(fileNameNoExt) {\n  const match = fileNameNoExt.match(/-([A-Za-z0-9]{15,25})$/);\n  if (match) return match[1];\n  return fileNameNoExt; // formato viejo: el nombre completo YA es el ID\n}\n\nconst githubMap = new Map();\nfor (const file of githubFiles) {\n  const fileName = file.json.name;\n  const nameNoExt = stripExt(fileName);\n  const id = extractId(nameNoExt);\n  githubMap.set(id, {\n    fileName,     // nombre real tal cual está en GitHub (con o sin .json)\n    nameNoExt,    // mismo nombre pero sin extensión, para comparar\n    filePath: file.json.path\n  });\n}\n\nconst commitDate = $('Establecer campos').first().json.commitDate;\nconst output = [];\n\nfor (const item of workflows) {\n  const wf = item.json;\n  const id = wf.id;\n  const currentName = wf.name;\n\n  const desiredNameNoExt = `${currentName}-${id}`; // sin extensión, como pediste\n  const newFilePath = `workflows/${desiredNameNoExt}`;\n  const newFileContent = JSON.stringify(wf, null, 2);\n\n  const existing = githubMap.get(id);\n\n  if (!existing) {\n    output.push({ json: {\n      action: 'create', id, name: currentName,\n      newFilePath, newFileContent,\n      commitMessage: `Create workflow backup: ${currentName} (${commitDate})`\n    }});\n  } else if (existing.nameNoExt !== desiredNameNoExt) {\n    output.push({ json: {\n      action: 'rename', id, name: currentName,\n      oldFilePath: existing.filePath,\n      newFilePath, newFileContent,\n      commitMessage: `Rename workflow backup: ${existing.fileName} -> ${desiredNameNoExt} (${commitDate})`\n    }});\n  } else {\n    // Solo cambiaba la extensión (o es idéntico) -> usa el path REAL existente\n    // para actualizar el mismo archivo en vez de crear uno con otra extensión.\n    output.push({ json: {\n      action: 'update', id, name: currentName,\n      newFilePath: existing.filePath,\n      newFileContent,\n      commitMessage: `Update workflow backup: ${currentName} (${commitDate})`\n    }});\n  }\n}\n\nreturn output;"
      },
