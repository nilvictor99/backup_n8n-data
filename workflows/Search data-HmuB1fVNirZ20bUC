      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // Obtener el texto original (maneja caso nulo o indefinido)\n  const rawText = item.json.output || '';\n\n  // Limpiar: eliminar saltos de línea, retornos, tabs y normalizar espacios\n  const cleanText = rawText\n    .replace(/[\\r\\n\\t]+/g, ' ')   // Reemplazar \\r, \\n, \\t por espacio\n    .replace(/\\s+/g, ' ')         // Reemplazar múltiples espacios por uno solo\n    .trim();                      // Eliminar espacios al inicio y al final\n\n  // Asignar el texto limpio a un nuevo campo (puedes llamarlo como quieras)\n  item.json.cleanQuery = cleanText;\n}\n\nreturn $input.all();"
      },
