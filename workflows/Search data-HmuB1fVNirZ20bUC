      "parameters": {
        "jsCode": "// Entrada del nodo (generalmente es el JSON que recibes desde el flujo anterior)\nconst input = $json; // generalmente es el JSON que pasa de un nodo anterior en n8n\n\n// Verificamos si 'results' existe en la entrada, si no, retornamos un texto vacío\nif (!input.results || !Array.isArray(input.results)) {\n    return { accumulatedContent: \"\" };\n}\n\n// Acumulamos el contenido de todos los artículos en una sola variable\nlet accumulatedContent = \"\";\n\n// Iteramos sobre los resultados\ninput.results.forEach(item => {\n    // Aseguramos que el ítem tenga los campos que necesitamos y los concatenamos\n    if (item.title) accumulatedContent += `Title: ${item.title}\\n`;\n    if (item.published_date) accumulatedContent += `Published Date: ${item.published_date}\\n`;\n    if (item.content) accumulatedContent += `Content: ${item.content}\\n\\n`;\n});\n\n// Retornamos el contenido acumulado en una sola variable\nreturn { accumulatedContent : accumulatedContent };"
      },
