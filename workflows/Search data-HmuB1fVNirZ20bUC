    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  let text = item.json.output || '';\n\n  // Eliminar retornos de carro (\\r) y tabulaciones\n  text = text.replace(/[\\r\\t]/g, ' ');\n\n  // Eliminar formato de Markdown: **negrita**, *cursiva*, __subrayado__, etc.\n  text = text.replace(/\\*{1,2}([^*]+)\\*{1,2}/g, '$1'); // quita **texto** y *texto*\n  text = text.replace(/_{1,2}([^_]+)_{1,2}/g, '$1');   // quita __texto__ y _texto_\n\n  // Eliminar viñetas al inicio de líneas (aunque ya no habrá líneas, por precaución)\n  text = text.replace(/^\\s*[\\*\\-\\•]\\s+/gm, '');\n\n  // Eliminar backticks (código en línea o bloque)\n  text = text.replace(/`{1,3}/g, '');\n\n  // Reemplazar cualquier salto de línea (\\n) o secuencia de espacios por un solo espacio\n  text = text.replace(/\\s+/g, ' ');\n\n  // Eliminar espacios al inicio y al final\n  text = text.trim();\n\n  // Guardar resultado\n  item.json.cleanOutput = text;\n}\n\nreturn $input.all();"
      },
