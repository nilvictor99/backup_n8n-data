{"updatedAt":"2026-08-07T15:55:35.500Z","createdAt":"2026-08-06T13:28:54.314Z","id":"UVG59IJc0sCkL26i","name":"Scan-Drive → YouTube lite","active":false,"isArchived":false,"nodes":[{"parameters":{"jsCode":"return $input.all().map(item => {\n  const data = item.json;\n\n  const fileId = data.id || '';\n  const fileName = data.name || '';\n  const mimeType = data.mimeType || '';\n  const size = Number(data.size) || 0;\n  const extension = data.fileExtension\n    ? data.fileExtension.toLowerCase()\n    : (fileName.includes('.') ? fileName.split('.').pop().toLowerCase() : '');\n\n  let isToday = false;\n  if (data.createdTime) {\n    const fileDate = new Date(data.createdTime);\n    fileDate.setHours(0, 0, 0, 0);\n    const today = new Date();\n    today.setHours(0, 0, 0, 0);\n    isToday = fileDate.getTime() === today.getTime();\n  }\n\n  return {\n    json: {\n      id: fileId,\n      Nombre: fileName,\n      Tipo: mimeType,\n      Extension: extension,\n      Tamaño_bytes: size,\n      Tamaño_MB: size > 0 ? (size / 1048576).toFixed(2) + ' MB' : '—',\n      Creado: data.createdTime ? new Date(data.createdTime).toISOString().split('T')[0] : '',\n      Modificado: data.modifiedTime ? new Date(data.modifiedTime).toISOString().split('T')[0] : '',\n      Ultima_Actualizacion: new Date().toISOString(),\n      Today_Create: isToday\n    }\n  };\n});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-448,0],"id":"f8f5a7a3-3261-4909-8c99-cd42c0393f7d","name":"Procesa los Datos"},{"parameters":{"resource":"fileFolder","queryString":"=.mp4","returnAll":true,"filter":{},"options":{"fields":["id","kind","mimeType","name","size","createdTime","modifiedTime"]}},"type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[-608,0],"id":"d9219c79-1637-4fcf-993b-50a9414da4a1","name":"Busca Archivos","alwaysOutputData":true,"credentials":{"googleDriveOAuth2Api":{"id":"bPAvSDvNBNBpzbZp","name":"Google Drive account"}}},{"parameters":{"rule":{"interval":[{}]}},"type":"n8n-nodes